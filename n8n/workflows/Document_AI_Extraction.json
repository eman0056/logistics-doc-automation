{
  "name": "Document_AI_Extraction",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-extraction",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "options": {},
        "headerParametersUi": {
          "parameter": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "name": "Claude AI Node",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "={{ $json.body.webhookCallbackUrl || ('http://localhost:3000/api/documents/' + $json.body.documentId + '/extraction/canonical') }}",
        "options": {}
      },
      "name": "Callback Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Claude AI Node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude AI Node": {
      "main": [
        [
          {
            "node": "Callback Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
